# =====================================================================
# ExamInsight AI - Environment Configuration
# =====================================================================

# 1. Google Cloud Vision API (Handwriting DOCUMENT_TEXT_DETECTION)
# Option A: Path to Google Cloud Service Account JSON Key file (Recommended)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Option B: Google Cloud Vision API Key (Alternative)
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here

# 2. Google Gemini API (Multimodal Vision & Rubric Evaluation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EVAL_MODEL=gemini-1.5-flash

# 3. OCR Pipeline & Cost Optimization Settings
MAX_OCR_PAGES=20
OCR_CACHE_DIR=uploads/.ocr_cache

# 4. Application Security & Database Settings
SECRET_KEY=examinsight-super-secret-key-2025-change-in-production
ALGORITHM=HS256
DB_PATH=examinsight.db
